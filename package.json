{
  "name": "tts-stt-md-aloud",
  "displayName": "TTS / STT MD Aloud",
  "description": "Markdown preview that translates the text and reads it aloud; text to speech settings for all of VS Code in the side bar; a formatted view of JSON files",
  "version": "1.1.0",
  "publisher": "ninebits",
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/NineBitsLTD/tts-stt-md-aloud.git"
  },
  "homepage": "https://github.com/NineBitsLTD/tts-stt-md-aloud#readme",
  "bugs": {
    "url": "https://github.com/NineBitsLTD/tts-stt-md-aloud/issues"
  },
  "type": "module",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "preview",
    "text to speech",
    "speech to text",
    "tts",
    "stt",
    "read aloud",
    "voice",
    "translate",
    "json"
  ],
  "activationEvents": [
    "onFileSystem:json-formatted"
  ],
  "main": "dist/extension.cjs",
  "contributes": {
    "customEditors": [
      {
        "viewType": "tts-stt-md-aloud.preview",
        "displayName": "Markdown Preview (TTS / STT MD Aloud)",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "option"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tts-stt-md-aloud",
          "title": "TTS / STT",
          "icon": "resources/speaker.svg"
        }
      ]
    },
    "views": {
      "tts-stt-md-aloud": [
        {
          "type": "webview",
          "id": "tts-stt-md-aloud.speech",
          "name": "Speech"
        }
      ]
    },
    "commands": [
      {
        "command": "tts-stt-md-aloud.openPreview",
        "title": "Open Preview (Translate, Read Aloud)",
        "category": "MD Aloud",
        "icon": {
          "light": "resources/open-preview-light.svg",
          "dark": "resources/open-preview-dark.svg"
        }
      },
      {
        "command": "tts-stt-md-aloud.openRaw",
        "title": "Open as Raw Markdown",
        "category": "MD Aloud",
        "icon": "$(file-code)"
      },
      {
        "command": "tts-stt-md-aloud.openFormattedJson",
        "title": "Open Formatted JSON",
        "category": "MD Aloud",
        "icon": "$(file-text)"
      },
      {
        "command": "tts-stt-md-aloud.openRawJson",
        "title": "Open as Raw JSON",
        "category": "MD Aloud",
        "icon": "$(file-code)"
      },
      {
        "command": "tts-stt-md-aloud.speak",
        "title": "Speak Text",
        "category": "MD Aloud"
      },
      {
        "command": "tts-stt-md-aloud.stopSpeaking",
        "title": "Stop Speaking",
        "category": "MD Aloud"
      },
      {
        "command": "tts-stt-md-aloud.voices",
        "title": "Voices Offered to Extensions",
        "category": "MD Aloud"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "tts-stt-md-aloud.openPreview",
          "when": "resourceScheme == file && resourceExtname =~ /^\\.(md|markdown)$/i && !activeCustomEditorId && !isInDiffEditor",
          "group": "navigation"
        },
        {
          "command": "tts-stt-md-aloud.openRaw",
          "when": "activeCustomEditorId == tts-stt-md-aloud.preview",
          "group": "navigation"
        },
        {
          "command": "tts-stt-md-aloud.openFormattedJson",
          "when": "resourceScheme == file && resourceExtname =~ /^\\.jsonc?$/i && !activeCustomEditorId && !isInDiffEditor",
          "group": "navigation"
        },
        {
          "command": "tts-stt-md-aloud.openRawJson",
          "when": "resourceScheme == json-formatted",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "tts-stt-md-aloud.openPreview",
          "when": "resourceExtname =~ /^\\.(md|markdown)$/i"
        },
        {
          "command": "tts-stt-md-aloud.openRaw",
          "when": "activeCustomEditorId == tts-stt-md-aloud.preview"
        },
        {
          "command": "tts-stt-md-aloud.openFormattedJson",
          "when": "resourceExtname =~ /^\\.jsonc?$/i"
        },
        {
          "command": "tts-stt-md-aloud.openRawJson",
          "when": "resourceScheme == json-formatted"
        },
        {
          "command": "tts-stt-md-aloud.speak",
          "when": "false"
        },
        {
          "command": "tts-stt-md-aloud.stopSpeaking",
          "when": "false"
        },
        {
          "command": "tts-stt-md-aloud.voices",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "TTS / STT",
      "properties": {
        "ttsSttMdAloud.tts.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "order": 1,
          "description": "Text to speech: reading aloud in the Markdown preview and the speech asked for by other extensions."
        },
        "ttsSttMdAloud.tts.volume": {
          "type": "number",
          "default": 100,
          "minimum": 0,
          "maximum": 100,
          "scope": "application",
          "order": 2,
          "description": "Volume of the speech, in % of the volume set on the computer."
        },
        "ttsSttMdAloud.tts.rate": {
          "type": "number",
          "default": 1,
          "minimum": 0.5,
          "maximum": 2,
          "scope": "application",
          "order": 3,
          "description": "Speed of the speech (1 is the normal speed)."
        },
        "ttsSttMdAloud.tts.driver": {
          "type": "string",
          "default": "system",
          "scope": "application",
          "order": 4,
          "markdownDescription": "Driver of the speech: `system`, a driver added to `#ttsSttMdAloud.tts.drivers#`."
        },
        "ttsSttMdAloud.tts.drivers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "application",
          "order": 5,
          "markdownDescription": "Drivers offered besides System: `piper`, `silero`, `external:<server name>`."
        },
        "ttsSttMdAloud.tts.servers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "url"
            ]
          },
          "default": [],
          "scope": "application",
          "order": 6,
          "description": "External TTS servers (their keys are kept in the secret storage of VS Code)."
        },
        "ttsSttMdAloud.tts.voice": {
          "type": "string",
          "default": "",
          "scope": "application",
          "order": 7,
          "description": "The voice chosen in the side bar (the voice test)."
        },
        "ttsSttMdAloud.tts.voices": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "default": {},
          "scope": "application",
          "order": 8,
          "description": "Checked voices by driver: picked automatically for reading aloud and offered to other extensions."
        },
        "ttsSttMdAloud.stt.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "order": 11,
          "description": "Speech to text (planned); while it is on, the side bar shows the level of the microphone."
        },
        "ttsSttMdAloud.stt.volume": {
          "type": "number",
          "default": 100,
          "minimum": 0,
          "maximum": 200,
          "scope": "application",
          "order": 12,
          "description": "Gain of the microphone signal, in % (100 is the signal as recorded)."
        },
        "ttsSttMdAloud.stt.driver": {
          "type": "string",
          "default": "system",
          "scope": "application",
          "order": 13,
          "markdownDescription": "Driver of speech recognition: `system`, a driver added to `#ttsSttMdAloud.stt.drivers#`."
        },
        "ttsSttMdAloud.stt.drivers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "application",
          "order": 14,
          "markdownDescription": "Drivers offered besides System: `whisper`, `external:<server name>`."
        },
        "ttsSttMdAloud.stt.servers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "url"
            ]
          },
          "default": [],
          "scope": "application",
          "order": 15,
          "description": "External STT servers (their keys are kept in the secret storage of VS Code)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "pack": "vsce package --no-dependencies",
    "clean": "rm -rf dist",
    "clean:css-temp": "rm -f src/scss/*.css*",
    "copy:codicons": "mkdir -p dist/codicons && cp node_modules/@vscode/codicons/dist/codicon.css node_modules/@vscode/codicons/dist/codicon.ttf dist/codicons/",
    "compile:sass": "sass src/scss:src/scss",
    "build:js": "esbuild src/extension.js --bundle --minify --outfile=dist/extension.cjs --external:vscode --platform=node --format=cjs",
    "build:js-webview": "esbuild src/markdown.js src/speech.js --bundle --minify --outdir=dist/js",
    "build:css": "npm run compile:sass && esbuild src/scss/*.css --bundle --minify --outdir=dist/css --loader:.css=css && npm run clean:css-temp",
    "build": "npm run clean && npm run build:js && npm run build:js-webview && npm run build:css && npm run copy:codicons",
    "watch:js": "esbuild src/extension.js --bundle --outfile=dist/extension.cjs --external:vscode --platform=node --format=cjs --watch",
    "watch:js-webview": "esbuild src/markdown.js src/speech.js --bundle --outdir=dist/js --watch",
    "watch:css": "sass --watch --no-source-map src/scss:dist/css",
    "watch": "npm run build && concurrently 'npm:watch:*'"
  },
  "devDependencies": {
    "@types/node": "22.x",
    "@types/vscode": "^1.107.0",
    "@vscode/vsce": "^4.0.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.27.1",
    "eslint": "^9.39.1",
    "globals": "^16.0.0",
    "sass": "^1.96.0"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.44",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "marked": "^12.0.2"
  },
  "packageManager": "pnpm@10.15.0+sha512.486ebc259d3e999a4e8691ce03b5cac4a71cbeca39372a9b762cb500cfdf0873e2cb16abe3d951b1ee2cf012503f027b98b6584e4df22524e0c7450d9ec7aa7b"
}
