{
  "name": "tts-stt-aloud",
  "displayName": "TTS / STT Aloud",
  "description": "%description%",
  "version": "2.1.0",
  "publisher": "ninebits",
  "license": "SEE LICENSE IN COPYING",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/NineBitsLTD/tts-stt-aloud.git"
  },
  "homepage": "https://github.com/NineBitsLTD/tts-stt-aloud#readme",
  "bugs": {
    "url": "https://github.com/NineBitsLTD/tts-stt-aloud/issues"
  },
  "type": "module",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "text to speech",
    "speech to text",
    "tts",
    "stt",
    "read aloud",
    "voice",
    "json"
  ],
  "activationEvents": [
    "onFileSystem:json-formatted"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "main": "dist/extension.cjs",
  "l10n": "./l10n",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tts-stt-aloud",
          "title": "TTS / STT",
          "icon": "resources/speaker.svg"
        }
      ]
    },
    "views": {
      "tts-stt-aloud": [
        {
          "type": "webview",
          "id": "tts-stt-aloud.speech",
          "name": "%view.speech%"
        }
      ]
    },
    "commands": [
      {
        "command": "tts-stt-aloud.openFormattedJson",
        "title": "%cmd.openFormattedJson%",
        "category": "TTS / STT",
        "icon": "$(file-text)"
      },
      {
        "command": "tts-stt-aloud.openRawJson",
        "title": "%cmd.openRawJson%",
        "category": "TTS / STT",
        "icon": "$(file-code)"
      },
      {
        "command": "tts-stt-aloud.speak",
        "title": "%cmd.speak%",
        "category": "TTS / STT"
      },
      {
        "command": "tts-stt-aloud.stopSpeaking",
        "title": "%cmd.stopSpeaking%",
        "category": "TTS / STT"
      },
      {
        "command": "tts-stt-aloud.voices",
        "title": "%cmd.voices%",
        "category": "TTS / STT"
      },
      {
        "command": "tts-stt-aloud.record",
        "title": "%cmd.record%",
        "category": "TTS / STT"
      },
      {
        "command": "tts-stt-aloud.stopRecording",
        "title": "%cmd.stopRecording%",
        "category": "TTS / STT"
      },
      {
        "command": "tts-stt-aloud.playerPlay",
        "title": "%cmd.playerPlay%",
        "category": "TTS / STT",
        "icon": "$(play)"
      },
      {
        "command": "tts-stt-aloud.playerPause",
        "title": "%cmd.playerPause%",
        "category": "TTS / STT",
        "icon": "$(debug-pause)"
      },
      {
        "command": "tts-stt-aloud.playerResume",
        "title": "%cmd.playerResume%",
        "category": "TTS / STT",
        "icon": "$(play)"
      },
      {
        "command": "tts-stt-aloud.playerBack",
        "title": "%cmd.playerBack%",
        "category": "TTS / STT",
        "icon": "$(debug-reverse-continue)",
        "enablement": "ttsSttAloud.playerHasPrevious"
      },
      {
        "command": "tts-stt-aloud.playerForward",
        "title": "%cmd.playerForward%",
        "category": "TTS / STT",
        "icon": "$(debug-continue)",
        "enablement": "ttsSttAloud.playerHasNext"
      },
      {
        "command": "tts-stt-aloud.playerStop",
        "title": "%cmd.playerStop%",
        "category": "TTS / STT",
        "icon": "$(debug-stop)"
      },
      {
        "command": "tts-stt-aloud.dictate",
        "title": "%cmd.dictate%",
        "category": "TTS / STT",
        "icon": "$(record)"
      },
      {
        "command": "tts-stt-aloud.stopDictation",
        "title": "%cmd.stopDictation%",
        "category": "TTS / STT",
        "icon": "$(stop-circle)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "tts-stt-aloud.openFormattedJson",
          "when": "resourceScheme == file && resourceExtname =~ /^\\.jsonc?$/i && !activeCustomEditorId && !isInDiffEditor",
          "group": "navigation"
        },
        {
          "command": "tts-stt-aloud.openRawJson",
          "when": "resourceScheme == json-formatted",
          "group": "navigation"
        },
        {
          "command": "tts-stt-aloud.dictate",
          "when": "config.ttsSttAloud.stt.enabled && !ttsSttAloud.dictating && activeEditor =~ /^workbench\\.editors\\.(files\\.textFileEditor|textResourceEditor)$/",
          "group": "navigation@-1002"
        },
        {
          "command": "tts-stt-aloud.stopDictation",
          "when": "config.ttsSttAloud.stt.enabled && ttsSttAloud.dictating && activeEditor =~ /^workbench\\.editors\\.(files\\.textFileEditor|textResourceEditor)$/",
          "group": "navigation@-1002"
        },
        {
          "command": "tts-stt-aloud.playerPlay",
          "when": "config.ttsSttAloud.tts.enabled && !ttsSttAloud.playerActive && activeEditor =~ /^workbench\\.editors\\.(files\\.textFileEditor|textResourceEditor)$/",
          "group": "navigation@-1005"
        },
        {
          "command": "tts-stt-aloud.playerBack",
          "when": "config.ttsSttAloud.tts.enabled && ttsSttAloud.playerActive && activeEditor =~ /^workbench\\.editors\\.(files\\.textFileEditor|textResourceEditor)$/",
          "group": "navigation@-1006"
        },
        {
          "command": "tts-stt-aloud.playerPause",
          "when": "config.ttsSttAloud.tts.enabled && ttsSttAloud.playerActive && !ttsSttAloud.playerPaused && activeEditor =~ /^workbench\\.editors\\.(files\\.textFileEditor|textResourceEditor)$/",
          "group": "navigation@-1005"
        },
        {
          "command": "tts-stt-aloud.playerResume",
          "when": "config.ttsSttAloud.tts.enabled && ttsSttAloud.playerActive && ttsSttAloud.playerPaused && activeEditor =~ /^workbench\\.editors\\.(files\\.textFileEditor|textResourceEditor)$/",
          "group": "navigation@-1005"
        },
        {
          "command": "tts-stt-aloud.playerForward",
          "when": "config.ttsSttAloud.tts.enabled && ttsSttAloud.playerActive && activeEditor =~ /^workbench\\.editors\\.(files\\.textFileEditor|textResourceEditor)$/",
          "group": "navigation@-1004"
        },
        {
          "command": "tts-stt-aloud.playerStop",
          "when": "config.ttsSttAloud.tts.enabled && ttsSttAloud.playerActive && activeEditor =~ /^workbench\\.editors\\.(files\\.textFileEditor|textResourceEditor)$/",
          "group": "navigation@-1003"
        }
      ],
      "commandPalette": [
        {
          "command": "tts-stt-aloud.playerPlay",
          "when": "config.ttsSttAloud.tts.enabled && !ttsSttAloud.playerActive"
        },
        {
          "command": "tts-stt-aloud.playerPause",
          "when": "ttsSttAloud.playerActive && !ttsSttAloud.playerPaused"
        },
        {
          "command": "tts-stt-aloud.playerResume",
          "when": "ttsSttAloud.playerActive && ttsSttAloud.playerPaused"
        },
        {
          "command": "tts-stt-aloud.playerBack",
          "when": "ttsSttAloud.playerActive"
        },
        {
          "command": "tts-stt-aloud.playerForward",
          "when": "ttsSttAloud.playerActive"
        },
        {
          "command": "tts-stt-aloud.playerStop",
          "when": "ttsSttAloud.playerActive"
        },
        {
          "command": "tts-stt-aloud.dictate",
          "when": "config.ttsSttAloud.stt.enabled && !ttsSttAloud.dictating"
        },
        {
          "command": "tts-stt-aloud.stopDictation",
          "when": "ttsSttAloud.dictating"
        },
        {
          "command": "tts-stt-aloud.openFormattedJson",
          "when": "resourceExtname =~ /^\\.jsonc?$/i"
        },
        {
          "command": "tts-stt-aloud.openRawJson",
          "when": "resourceScheme == json-formatted"
        },
        {
          "command": "tts-stt-aloud.speak",
          "when": "false"
        },
        {
          "command": "tts-stt-aloud.stopSpeaking",
          "when": "false"
        },
        {
          "command": "tts-stt-aloud.voices",
          "when": "false"
        },
        {
          "command": "tts-stt-aloud.record",
          "when": "false"
        },
        {
          "command": "tts-stt-aloud.stopRecording",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "TTS / STT",
      "properties": {
        "ttsSttAloud.tts.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "order": 1,
          "description": "%config.tts.enabled%"
        },
        "ttsSttAloud.tts.volume": {
          "type": "number",
          "default": 100,
          "minimum": 0,
          "maximum": 100,
          "scope": "application",
          "order": 2,
          "description": "%config.tts.volume%"
        },
        "ttsSttAloud.tts.rate": {
          "type": "number",
          "default": 1,
          "minimum": 0.5,
          "maximum": 2,
          "scope": "application",
          "order": 3,
          "description": "%config.tts.rate%"
        },
        "ttsSttAloud.tts.activeDrivers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "system"
          ],
          "scope": "application",
          "order": 4,
          "markdownDescription": "%config.tts.activeDrivers%"
        },
        "ttsSttAloud.tts.drivers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "application",
          "order": 5,
          "markdownDescription": "%config.tts.drivers%"
        },
        "ttsSttAloud.tts.servers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "url"
            ]
          },
          "default": [],
          "scope": "application",
          "order": 6,
          "description": "%config.tts.servers%"
        },
        "ttsSttAloud.tts.voice": {
          "type": "string",
          "default": "",
          "scope": "application",
          "order": 7,
          "description": "%config.tts.voice%"
        },
        "ttsSttAloud.tts.voices": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "default": {},
          "scope": "application",
          "order": 8,
          "description": "%config.tts.voices%"
        },
        "ttsSttAloud.tts.models": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "default": {},
          "scope": "application",
          "order": 9,
          "description": "%config.tts.models%"
        },
        "ttsSttAloud.stt.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "order": 11,
          "description": "%config.stt.enabled%"
        },
        "ttsSttAloud.stt.volume": {
          "type": "number",
          "default": 100,
          "minimum": 0,
          "maximum": 200,
          "scope": "application",
          "order": 12,
          "description": "%config.stt.volume%"
        },
        "ttsSttAloud.stt.driver": {
          "type": "string",
          "default": "",
          "scope": "application",
          "order": 13,
          "markdownDescription": "%config.stt.driver%"
        },
        "ttsSttAloud.stt.drivers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "whisper"
          ],
          "scope": "application",
          "order": 14,
          "markdownDescription": "%config.stt.drivers%"
        },
        "ttsSttAloud.stt.servers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "url"
            ]
          },
          "default": [],
          "scope": "application",
          "order": 15,
          "description": "%config.stt.servers%"
        },
        "ttsSttAloud.stt.models": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "default": {},
          "scope": "application",
          "order": 16,
          "description": "%config.stt.models%"
        },
        "ttsSttAloud.stt.model": {
          "type": "string",
          "default": "",
          "scope": "application",
          "order": 17,
          "description": "%config.stt.model%"
        },
        "ttsSttAloud.stt.language": {
          "type": "string",
          "default": "",
          "scope": "application",
          "order": 18,
          "description": "%config.stt.language%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "pack": "node scripts/pack.mjs",
    "clean": "rm -rf dist",
    "clean:css-temp": "rm -f src/scss/*.css*",
    "copy:codicons": "mkdir -p dist/codicons && cp node_modules/@vscode/codicons/dist/codicon.css node_modules/@vscode/codicons/dist/codicon.ttf dist/codicons/",
    "copy:runtime": "node scripts/copy-runtime.mjs",
    "notices": "node scripts/third-party-notices.mjs",
    "compile:sass": "sass src/scss:src/scss",
    "build:js": "esbuild src/extension.js --bundle --minify --outfile=dist/extension.cjs --external:vscode --platform=node --format=cjs",
    "build:js-webview": "esbuild src/speech.js --bundle --minify --outdir=dist/js",
    "build:css": "npm run compile:sass && esbuild src/scss/*.css --bundle --minify --outdir=dist/css --loader:.css=css && npm run clean:css-temp",
    "build": "npm run clean && npm run build:js && npm run build:js-webview && npm run build:css && npm run copy:codicons && npm run copy:runtime",
    "watch:js": "esbuild src/extension.js --bundle --outfile=dist/extension.cjs --external:vscode --platform=node --format=cjs --watch",
    "watch:js-webview": "esbuild src/speech.js --bundle --outdir=dist/js --watch",
    "watch:css": "sass --watch --no-source-map src/scss:dist/css",
    "watch": "npm run build && concurrently 'npm:watch:*'"
  },
  "devDependencies": {
    "@types/node": "22.x",
    "@types/vscode": "^1.107.0",
    "@vscode/vsce": "^4.0.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.27.1",
    "eslint": "^9.39.1",
    "globals": "^16.0.0",
    "sass": "^1.96.0"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.44",
    "marked": "^12.0.2",
    "parse5": "^8.1.0",
    "piper-phonemize": "1.5.9",
    "sherpa-onnx-node": "2.0.1"
  },
  "packageManager": "pnpm@10.15.0+sha512.486ebc259d3e999a4e8691ce03b5cac4a71cbeca39372a9b762cb500cfdf0873e2cb16abe3d951b1ee2cf012503f027b98b6584e4df22524e0c7450d9ec7aa7b"
}
